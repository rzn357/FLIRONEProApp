<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (used by the diagnostics screen). -->
    <style name="Theme.FLIRONEProApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Dark dialogs for the live view screen. -->
    <style name="ThemeOverlay.FLIRONEProApp.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/text_primary_on_dark</item>
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="android:textColorPrimary">@color/text_primary_on_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_on_dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FLIRONEProApp.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FLIRONEProApp.DialogButton</item>
    </style>

    <style name="Widget.FLIRONEProApp.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_amber</item>
    </style>

    <!-- Live view screen: no action bar, black background, dark dialogs. -->
    <style name="Theme.FLIRONEProApp.Stream" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="colorSecondaryVariant">@color/accent_amber</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FLIRONEProApp.Dialog</item>
    </style>
</resources>
